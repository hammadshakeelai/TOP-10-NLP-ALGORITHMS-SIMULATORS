  {
    "id": "fasttext",
    "name": "FastText",
    "family": "classification",
    "description": "Subword-aware text classification simulator with character n-gram breakdown and supervised classification.",
    "use_cases": [
      "fast text classification",
      "misspelling robustness",
      "subword visualization"
    ],
    "input_types": [
      "documents",
      "text"
    ],
    "parameter_schema": [
      {
        "name": "min_n",
        "type": "int",
        "default": 3,
        "description": "Minimum character n-gram length.",
        "min": 1,
        "max": 6
      },
      {
        "name": "max_n",
        "type": "int",
        "default": 6,
        "description": "Maximum character n-gram length.",
        "min": 1,
        "max": 10
      },
      {
        "name": "epochs",
        "type": "int",
        "default": 5,
        "description": "Training epochs when supervised mode is available.",
        "min": 1,
        "max": 50
      },
      {
        "name": "lr",
        "type": "float",
        "default": 0.1,
        "description": "Learning rate.",
        "min": 0.001,
        "max": 1.0
      },
      {
        "name": "word_ngrams",
        "type": "int",
        "default": 1,
        "description": "Word n-gram feature length.",
        "min": 1,
        "max": 5
      }
    ],
    "supported_modes": [
      "learning",
      "experiment"
    ],
    "complexity": "O(N * ngrams)",
    "requires_gpu": false,
    "is_async": false
  }
