        "description": "HuggingFace generation checkpoint."
      },
      {
        "name": "max_new_tokens",
        "type": "int",
        "default": 100,
        "description": "Maximum generated tokens.",
        "min": 1,
        "max": 512
      },
      {
        "name": "temperature",
        "type": "float",
        "default": 0.8,
        "description": "Sampling temperature.",
