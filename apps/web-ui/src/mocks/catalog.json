        "max": 2.0
      },
      {
        "name": "top_k",
        "type": "int",
        "default": 50,
        "description": "Top-k sampling cutoff.",
        "min": 0,
        "max": 200
      },
      {
        "name": "top_p",
        "type": "float",
        "default": 0.95,
        "description": "Nucleus sampling cutoff.",
