# Copy to .env.local and edit. All three are read at BUILD time, not runtime.

# "true" builds a backend-free bundle served from src/mocks/ snapshots.
# Leave unset for normal development against a running FastAPI gateway.
VITE_STATIC_MODE=

# Sub-path the site is served from. GitHub Pages project sites need "/<repo>/".
# Leave unset (or "/") for root-serving hosts and local development.
VITE_BASE_PATH=

# API gateway URL. Ignored entirely when VITE_STATIC_MODE=true.
VITE_API_URL=http://localhost:8000
